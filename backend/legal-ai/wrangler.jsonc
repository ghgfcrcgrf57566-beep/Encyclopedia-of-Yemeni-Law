{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odd-mouse-c1e0",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yemen_laws_db",
      "database_id": "2bbc13e8-3cd5-470d-8753-94ef34cef256"
    }
  ],

  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "yemen-laws-articles"
    }
  ],

  "secrets": {
    "required": [
      "REINDEX_TOKEN"
    ]
  },

  "vars": {
    "ALLOWED_APP_VERSION": "1.0.0",
    "MAX_QUESTION_CHARS": "1200",
    "MAX_RESULTS": "8",
    "MIN_RELEVANCE_SCORE": "0.15",
    "AI_PROVIDER": "gemini",
    "AI_MODEL": "gemini-3.8-flash",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3"
  }
}
